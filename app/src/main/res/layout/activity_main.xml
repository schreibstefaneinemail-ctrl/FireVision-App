<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0D0F12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FireVision TDA"
        android:textColor="#FF7A18"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"/>

    <!-- Kesseltemperatur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161A20"
        android:padding="16dp"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KESSELTEMPERATUR"
            android:textColor="#8A99AD"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txtKessel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- °C"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Puffer & WW Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161A20"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/txtPufferOben"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puffer Oben: -- °C"
            android:textColor="#FFA502"
            android:textSize="18sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/txtPufferUnten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puffer Unten: -- °C"
            android:textColor="#1E90FF"
            android:textSize="18sp"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/txtWarmwasser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Warmwasser: -- °C"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bereit"
        android:textColor="#8A99AD"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daten jetzt aktualisieren"
        android:backgroundTint="#FF7A18"/>

</LinearLayout>
